            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Run Script"
               scriptText = "set -e&#10;&#10;APP_PATH=&quot;${ARCHIVE_PATH}/Products/Applications/PainThink.app&quot;&#10;FRAMEWORKS_PATH=&quot;${APP_PATH}/Frameworks&quot;&#10;&#10;echo &quot;&#x1f50d; Archive path: ${ARCHIVE_PATH}&quot;&#10;echo &quot;&#x1f50d; Frameworks path: ${FRAMEWORKS_PATH}&quot;&#10;&#10;for framework in &quot;onnxruntime&quot; &quot;onnxruntime_extensions&quot;; do&#10;    PLIST=&quot;${FRAMEWORKS_PATH}/${framework}.framework/Info.plist&quot;&#10;    if [ -f &quot;$PLIST&quot; ]; then&#10;        echo &quot;&#x2705; Ditemukan $framework, patching...&quot;&#10;        /usr/libexec/PlistBuddy -c &quot;Delete :MinimumOSVersion&quot; &quot;$PLIST&quot; 2&gt;/dev/null || true&#10;        /usr/libexec/PlistBuddy -c &quot;Add :MinimumOSVersion string 17.6&quot; &quot;$PLIST&quot;&#10;        echo &quot;&#x2705; Hasil patch: $(/usr/libexec/PlistBuddy -c &apos;Print :MinimumOSVersion&apos; &quot;$PLIST&quot;)&quot;&#10;    else&#10;        echo &quot;&#x274c; TIDAK DITEMUKAN: $PLIST&quot;&#10;    fi&#10;done&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "A152865F3024539400518651"
                     BuildableName = "PainThink.app"
                     BlueprintName = "PainThink"
                     ReferencedContainer = "container:PainThink.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
